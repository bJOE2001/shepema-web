# Supabase Configuration for Shepema Web
# Get these from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Resend API Key for sending update emails to subscribers
# Get this from https://resend.com/api-keys
VITE_RESEND_API_KEY=re_123456789
VITE_RESEND_FROM_EMAIL=Shepema Updates <updates@shepema.com>
